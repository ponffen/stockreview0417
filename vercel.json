{
  "buildCommand": "npm run build",
  "functions": {
    "api/assets.js": {
      "includeFiles": "api/public/**"
    },
    "api/index.js": {
      "includeFiles": "api/public/**",
      "maxDuration": 60
    },
    "api/static.js": {
      "includeFiles": "api/public/**"
    }
  },
  "crons": [
    { "path": "/api/cron/sync-daily-close", "schedule": "30 23 * * *" },
    { "path": "/api/cron/freeze-eod", "schedule": "35 0 * * *" }
  ],
  "rewrites": [
    { "source": "/api/health", "destination": "/api/health" },
    { "source": "/api/health/", "destination": "/api/health" },
    { "source": "/api/health/db", "destination": "/api/health-db" },
    {
      "source": "/api/sina-kline",
      "destination": "https://market-oxy-http-market-proxy-pbftovdfne.cn-hangzhou.fcapp.run/api/sina-kline"
    },
    {
      "source": "/api/sina-kline/",
      "destination": "https://market-oxy-http-market-proxy-pbftovdfne.cn-hangzhou.fcapp.run/api/sina-kline"
    },
    {
      "source": "/api/sina_kline",
      "destination": "https://market-oxy-http-market-proxy-pbftovdfne.cn-hangzhou.fcapp.run/api/sina-kline"
    },
    {
      "source": "/api/sina_kline/",
      "destination": "https://market-oxy-http-market-proxy-pbftovdfne.cn-hangzhou.fcapp.run/api/sina-kline"
    },
    {
      "source": "/api/quote/tencent",
      "destination": "https://market-oxy-http-market-proxy-pbftovdfne.cn-hangzhou.fcapp.run/api/quote/tencent"
    },
    {
      "source": "/api/market/snapshot",
      "destination": "https://market-oxy-http-market-proxy-pbftovdfne.cn-hangzhou.fcapp.run/api/market/snapshot"
    },
    {
      "source": "/api/sina/suggest",
      "destination": "https://market-suggest-akylmuviow.cn-hangzhou.fcapp.run/api/sina/suggest"
    },
    {
      "source": "/api/sina/suggest/",
      "destination": "https://market-suggest-akylmuviow.cn-hangzhou.fcapp.run/api/sina/suggest"
    },
    { "source": "/api/assets", "destination": "/api/assets" },
    { "source": "/api/assets/", "destination": "/api/assets" },
    { "source": "/favicon.ico", "destination": "/api/assets?file=favicon.ico" },
    { "source": "/public/icon.png", "destination": "/api/assets?file=public/icon.png" },
    { "source": "/icon.png", "destination": "/api/assets?file=icon.png" },
    { "source": "/styles.css", "destination": "/api/assets?file=styles.css" },
    { "source": "/app.js", "destination": "/api/assets?file=app.js" },
    { "source": "/quote-smoke-test.html", "destination": "/api/assets?file=quote-smoke-test.html" },
    { "source": "/api/(.*)", "destination": "/api/index" },
    { "source": "/(.*)", "destination": "/api/index" }
  ]
}
